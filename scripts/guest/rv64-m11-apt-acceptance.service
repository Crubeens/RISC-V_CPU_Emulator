[Unit]
Description=RV64 M11 APT and persistence acceptance
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/rv64-m11/phase3-complete

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rv64-m11-apt-acceptance
TimeoutStartSec=infinity
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
